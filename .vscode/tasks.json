{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Activate Virtual Environment and Run Streamlit",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/k",
                ".venv\\Scripts\\activate && streamlit run src\\SuperSTATs\\Main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}