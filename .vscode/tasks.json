{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Activate Streamlit",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/k",
                ".\\.venv\\Scripts\\activate && streamlit run src\\SuperSTATs\\Home.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}